
# Application
NODE_ENV="development"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Storefront: support phone (E.164) for order confirmation tel: link (optional override)
NEXT_PUBLIC_SUPPORT_PHONE_E164=""

# Database (PostgreSQL via Prisma; Neon on Vercel)
# Pooled connection for the app (Neon "pooled" / `-pooler` host). Required in all deployed environments.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Direct (non-pooler) URL for migrations (`prisma migrate deploy`). Set in CI/local migrate; Vercel runtime often only needs DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_CONNECTION_LIMIT="10"
DATABASE_POOL_TIMEOUT="20"


# Authentication
JWT_SECRET=""
JWT_EXPIRES_IN="7d"


# ——— Cache (Upstash Redis) ———
UPSTASH_REDIS_REST_URL="https://..."
UPSTASH_REDIS_REST_TOKEN=""


# ——— Email (Resend) ———
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# ——— File storage (Cloudflare R2) ———
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# Public base URL for uploaded assets (required). Example: https://pub-xxxxx.r2.dev or your custom CDN domain.
R2_PUBLIC_URL=""

# ——— Figma (MCP) ———
FIGMA_ACCESS_TOKEN=""

# ——— ArmSoft SalesManagement (ERP / warehouse) ———
# Swagger: https://api.armsoft.am/sm/swagger/index.html
# Auth: header `apiKey`
# Stock + price + name sync every 15m (Vercel Cron) + admin POST
# SKU = ArmSoft product code → ProductVariant / hy title
ARMSOFT_SM_BASE_URL="https://api.armsoft.am/sm"
ARMSOFT_SM_API_KEY=""
# Optional: limit to one warehouse code (e.g. "000"). Empty = sum all warehouses.
ARMSOFT_SM_STORAGE=""
ARMSOFT_SM_ACCEPT_LANGUAGE="hy-AM"
# Price list type for remainders price field
ARMSOFT_SM_PRICELIST_TYPE="01"
# Optional AMD→USD rate override (shop stores USD). Empty = settings.currencyRates.AMD
ARMSOFT_SM_AMD_TO_USD_RATE=""

# Vercel Cron auth for /api/v1/cron/armsoft-stock-sync (Authorization: Bearer …)
CRON_SECRET=""


